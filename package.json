{
  "name": "circom-zkvm",
  "version": "1.0.0",
  "description": "Educational stack-based zkVM in Circom based on the RareSkills zkVM article.",
  "private": true,
  "scripts": {
    "assemble": "node scripts/assemble.js",
    "compile": "mkdir -p build && circom circuits/zkvm.circom --r1cs --wasm --sym -o build",
    "compile:hash": "mkdir -p build && circom circuits/program_hash.circom --r1cs --wasm --sym -o build",
    "compile:trace": "mkdir -p build && circom circuits/zkvm_trace.circom --r1cs --wasm --sym -o build",
    "test": "node --test test/**/*.test.js"
  },
  "dependencies": {
    "circomlib": "^2.0.5"
  },
  "overrides": {
    "bfj": "^9.1.3",
    "underscore": "^1.13.8"
  },
  "devDependencies": {
    "circom_tester": "^0.0.24"
  }
}
